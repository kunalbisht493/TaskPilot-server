# ===================================================
# TaskPilot — Git Ignore Configuration
# ===================================================

# Environment variables & API credentials (CRITICAL: Never commit secrets)
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
token.json

# Dependencies
node_modules/
jspm_packages/

# Logs & debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor caches
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.sw?

# Testing & Coverage
coverage/
.nyc_output/

# Temporary & build outputs
dist/
build/
.cache/
.tmp/
scratch/
